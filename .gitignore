# --- uaef-service deploy app ---
# CDK synth output (build artifact; never commit)
cdk.out/
uaef-service/cdk.out/
# Built UI bundle (Vite output)
uaef-service/ui/app/dist/
# Build-time generated metric catalog (regenerated on each deploy)
uaef-service/handlers/catalog.json
# User config files (contain environment-specific secrets/values)
uaef-service/config*.yaml
uaef-service/config*.yaml.*
!uaef-service/config.yaml.example
# CDK deploy outputs
uaef-service/outputs.json
# Accidental pip output file
uaef-service/=*
# The global "*.html" rule above would skip the deployed UI's Vite entry;
# keep it so clones can build the frontend.
!uaef-service/ui/app/index.html
.awsenv.sh

# ASH (Automated Security Helper) scan output — regenerated on every scan.
.ash/

# Kiro IDE workspace settings (local, per-developer).
.kiro/
