          {
            "role": "user",
            "content": "Divide",
            "timestamp": "2024-04-15T10:00:00Z"
          }
        ],
        "tool_calls": [
          {
            "name": "divide",
            "arguments": {
              "dividend": 25,
              "divisor": 100
            },
            "timestamp": "2024-04-15T10:00:01Z"
          }
        ]
      },
      "ground_truth": {
        "expected_tool_calls": [
          {
            "name": "divide",
            "arguments": {
              "dividend": 100,
              "divisor": 25
            }
          }
        ]
      }
    },
