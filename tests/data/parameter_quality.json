{
  "test_cases": [
    {
      "name": "perfect_parameters",
      "description": "All parameters match perfectly",
      "scenario_type": "happy_path",
      "expected_score": 1.0,
      "trace": {
        "messages": [
          {
            "role": "user",
            "content": "Search",
            "timestamp": "2024-04-15T10:00:00Z"
          }
        ],
        "tool_calls": [
          {
            "name": "search",
            "arguments": {
              "query": "Paris",
              "limit": 10
            },
            "timestamp": "2024-04-15T10:00:01Z"
          }
        ]
      },
      "ground_truth": {
        "expected_tool_calls": [
          {
            "name": "search",
            "arguments": {
              "query": "Paris",
              "limit": 10
            }
          }
        ]
      }
    },
    {
      "name": "swapped_parameters",
