          }
        },
        "coordination_events": [
          {"from_agent": "pipeline_manager", "to_agent": "data_ingestion_agent", "event_type": "DELEGATE", "message": "Download sales_2024_q1.csv from s3://data-lake/raw/ and validate the schema has 12 columns", "timestamp": "2024-04-15T10:00:02Z"},
