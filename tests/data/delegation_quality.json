    {
      "name": "efficient_code_review_pipeline",
      "description": "Efficient two-agent handoff: linter runs first, then reviewer gets clean results",
      "scenario_type": "good_delegation",
      "multi_agent_trace": {
        "workflow_id": "del_006",
        "workflow_status": "COMPLETED",
        "agent_traces": {
          "linter_agent": {
            "messages": [
              {"role": "user", "content": "Run static analysis on the PR diff for repository backend-api, PR #482", "timestamp": "2024-04-15T10:00:00Z"},
              {"role": "assistant", "content": "Static analysis complete. Found 3 warnings: unused import on line 12, missing type hint on line 45, line too long on line 78.", "timestamp": "2024-04-15T10:00:08Z"}
            ],
            "tool_calls": [
              {"name": "fetch_pr_diff", "arguments": {"repo": "backend-api", "pr": 482}, "timestamp": "2024-04-15T10:00:01Z"},
              {"name": "run_pylint", "arguments": {"files": ["src/handlers/auth.py"]}, "timestamp": "2024-04-15T10:00:03Z"},
              {"name": "run_mypy", "arguments": {"files": ["src/handlers/auth.py"]}, "timestamp": "2024-04-15T10:00:05Z"},
              {"name": "run_black_check", "arguments": {"files": ["src/handlers/auth.py"]}, "timestamp": "2024-04-15T10:00:07Z"}
            ]
          },
          "reviewer_agent": {
            "messages": [
              {"role": "user", "content": "Review the PR diff and lint results for backend-api PR #482", "timestamp": "2024-04-15T10:00:09Z"},
              {"role": "assistant", "content": "Review complete. The auth handler changes look correct. Recommend fixing the 3 lint warnings before merge. No security concerns found.", "timestamp": "2024-04-15T10:00:15Z"}
            ],
            "tool_calls": [
              {"name": "analyze_code_changes", "arguments": {"repo": "backend-api", "pr": 482}, "timestamp": "2024-04-15T10:00:10Z"},
              {"name": "check_security_patterns", "arguments": {"files": ["src/handlers/auth.py"]}, "timestamp": "2024-04-15T10:00:12Z"},
              {"name": "post_review_comment", "arguments": {"pr": 482, "status": "approve_with_suggestions"}, "timestamp": "2024-04-15T10:00:14Z"}
            ]
          }
        },
        "coordination_events": [
          {"from_agent": "linter_agent", "to_agent": "reviewer_agent", "event_type": "HANDOFF", "message": "Lint results for PR #482: 3 warnings (unused import, missing type hint, line length). No errors.", "timestamp": "2024-04-15T10:00:09Z"}
        ]
      }
    },
