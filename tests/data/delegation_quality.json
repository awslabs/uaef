{
  "test_cases": [
    {
      "name": "appropriate_delegation",
      "description": "Orchestrator correctly delegates research to research agent and summarization to summary agent",
      "scenario_type": "good_delegation",
      "multi_agent_trace": {
        "workflow_id": "del_001",
        "workflow_status": "COMPLETED",
        "agent_traces": {
          "orchestrator": {
            "messages": [
              {"role": "user", "content": "Find recent papers on transformer architectures and summarize the key findings", "timestamp": "2024-04-15T10:00:00Z"},
              {"role": "assistant", "content": "I'll coordinate this. Delegating literature search to the research agent and then summarization to the summary agent.", "timestamp": "2024-04-15T10:00:01Z"}
            ],
            "tool_calls": [
              {"name": "plan_workflow", "arguments": {"steps": ["research", "summarize"]}, "timestamp": "2024-04-15T10:00:01Z"}
            ]
          },
          "research_agent": {
            "messages": [
              {"role": "user", "content": "Search for recent papers on transformer architectures published in 2024", "timestamp": "2024-04-15T10:00:02Z"},
              {"role": "assistant", "content": "Found 12 relevant papers. Top results include 'Efficient Attention Mechanisms' and 'Scaling Laws Revisited'.", "timestamp": "2024-04-15T10:00:10Z"}
            ],
            "tool_calls": [
              {"name": "search_arxiv", "arguments": {"query": "transformer architectures 2024"}, "timestamp": "2024-04-15T10:00:03Z"},
              {"name": "fetch_paper_metadata", "arguments": {"paper_ids": ["2401.001", "2401.002"]}, "timestamp": "2024-04-15T10:00:06Z"},
              {"name": "extract_abstracts", "arguments": {"paper_ids": ["2401.001", "2401.002"]}, "timestamp": "2024-04-15T10:00:08Z"}
            ]
          },
          "summary_agent": {
            "messages": [
              {"role": "user", "content": "Summarize the key findings from these transformer architecture papers", "timestamp": "2024-04-15T10:00:11Z"},
              {"role": "assistant", "content": "Key findings: 1) Linear attention reduces complexity to O(n). 2) Scaling laws show diminishing returns past 100B params.", "timestamp": "2024-04-15T10:00:15Z"}
            ],
            "tool_calls": [
              {"name": "generate_summary", "arguments": {"style": "bullet_points"}, "timestamp": "2024-04-15T10:00:12Z"},
              {"name": "format_output", "arguments": {"format": "markdown"}, "timestamp": "2024-04-15T10:00:14Z"}
            ]
          }
        },
        "coordination_events": [
          {"from_agent": "orchestrator", "to_agent": "research_agent", "event_type": "DELEGATE", "message": "Search for recent papers on transformer architectures published in 2024 and extract abstracts", "timestamp": "2024-04-15T10:00:02Z"},
          {"from_agent": "research_agent", "to_agent": "orchestrator", "event_type": "REPORT", "message": "Found 12 papers, extracted abstracts for top 2", "timestamp": "2024-04-15T10:00:10Z"},
          {"from_agent": "orchestrator", "to_agent": "summary_agent", "event_type": "DELEGATE", "message": "Summarize key findings from the extracted paper abstracts", "timestamp": "2024-04-15T10:00:11Z"}
        ]
      }
    },
