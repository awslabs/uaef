    {
      "name": "duplicate_tool_names_match",
      "description": "Both expect and call send_email twice (names match) - Jaccard = 2/2 = 1.0",
      "scenario_type": "multiple_calls",
      "expected_score": 1.0,
      "trace": {
        "messages": [
          {
            "role": "user",
            "content": "Email Alice and Bob",
            "timestamp": "2024-04-15T10:00:00Z"
          }
        ],
        "tool_calls": [
          {
            "name": "send_email",
            "arguments": {
              "to": "alice@test.com"
            },
            "timestamp": "2024-04-15T10:00:01Z"
          },
          {
            "name": "send_email",
            "arguments": {
              "to": "alice@test.com"
            },
            "timestamp": "2024-04-15T10:00:02Z"
          }
        ]
      },
      "ground_truth": {
        "expected_tool_calls": [
          {
            "name": "send_email",
            "arguments": {
              "to": "alice@test.com"
            }
          },
          {
            "name": "send_email",
            "arguments": {
              "to": "bob@test.com"
            }
          }
        ]
      }
    },
