{
  "test_cases": [
    {
      "name": "perfect_match",
      "description": "All tools correct (names match)",
      "scenario_type": "happy_path",
      "expected_score": 1.0,
      "trace": {
        "messages": [
          {
            "role": "user",
            "content": "Search for Paris weather",
            "timestamp": "2024-04-15T10:00:00Z"
          },
          {
            "role": "assistant",
            "content": "Searching...",
            "timestamp": "2024-04-15T10:00:01Z"
          }
        ],
        "tool_calls": [
          {
            "name": "search",
            "arguments": {
              "query": "Paris weather"
            },
            "timestamp": "2024-04-15T10:00:01Z"
          }
        ]
      },
      "ground_truth": {
        "expected_tool_calls": [
          {
            "name": "search",
            "arguments": {
              "query": "Paris weather"
            }
          }
        ]
      }
    },
    {
